# Copy to frontend/.env.production before running the build step — Vite
# picks this up automatically for `npm run build`.

# Left empty on purpose: frontend and API share the same origin in
# production (same nginx, same port), so requests are made as relative
# paths (e.g. /api/...) and just work regardless of IP or domain.
VITE_API_URL=

VITE_CONTACT_WHATSAPP_NUMBER=+212669308243
