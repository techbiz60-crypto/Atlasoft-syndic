# Copy to backend/.env on the VPS, then fill in the placeholders below.
# DB_PASSWORD must match the value you put in the root .env (see
# .env.prod.example) — that's what actually creates the MySQL user/password.

APP_NAME=AtlasoftSyndic
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Replace with your VPS's public IP and the nginx port from
# docker-compose.prod.yml (8082 by default), e.g. http://123.45.67.89:8082
APP_URL=http://VPS_IP:8082

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=atlasoft_syndic
DB_USERNAME=atlasoft_syndic
DB_PASSWORD=change-me-to-a-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Bare IP addresses can't be set here (cookies don't scope to an IP the
# same way as a domain) — leave this null so the session cookie is scoped
# to whichever host the request came in on. Set this to your real domain
# once you have one.
SESSION_DOMAIN=null

# Frontend is served from the same origin as the API in production (same
# nginx, same port) — so this is just that one address, and Sanctum's
# stateful check needs the host:port (no scheme) to match.
FRONTEND_URLS=http://VPS_IP:8082
FRONTEND_URL=http://VPS_IP:8082
SANCTUM_STATEFUL_DOMAINS=VPS_IP:8082
CONTACT_WHATSAPP_NUMBER=+212669308243

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Still pointed at the Mailtrap sandbox used during development — real
# emails (verification links, etc.) will NOT reach actual inboxes until
# this is swapped for a real transactional mail provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS="no-reply@atlasoft-syndic.ma"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
