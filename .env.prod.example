# Copied to ".env" at the project root before running docker compose — this
# is ONLY read by docker-compose.prod.yml to set the MySQL container's
# passwords. Laravel's own settings live separately in backend/.env.
#
# Generate strong random values, e.g.: openssl rand -base64 24
DB_PASSWORD=change-me-to-a-strong-password
DB_ROOT_PASSWORD=change-me-to-a-different-strong-password
